# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# The app's connection to Postgres.
# On Neon use the "pooled" connection string; on a local Postgres just the normal one.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Used only for migrations (pnpm db:migrate) and the seed scripts.
# On Neon this is the "direct" (non-pooled) string. If you leave it out,
# DATABASE_URL is used, which is fine for a local Postgres.
DATABASE_URL_UNPOOLED=

# Login sessions are signed with this. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-value
BETTER_AUTH_URL=http://localhost:3000
