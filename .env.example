# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# The app's connection to Postgres.
# On Neon use the "pooled" connection string; on a local Postgres just the normal one.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Used by migrations and backups (pnpm db:migrate, pnpm db:backup) ONLY. The
# seed script goes through src/db and reads DATABASE_URL above, like the app
# does. A DATABASE_URL given on the command line on its own is used instead of
# this, whole: this string belongs to this file's database.
# On Neon this is the "direct" (non-pooled) string. If you leave it out,
# DATABASE_URL is used, which is fine for a local Postgres.
DATABASE_URL_UNPOOLED=

# Login sessions are signed with this. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-value
BETTER_AUTH_URL=http://localhost:3000

# Optional. The request header your hosting sets itself with the visitor's IP
# address, for the sign-in flood guard and the audit log. Leave it out on
# Vercel, which overwrites X-Forwarded-For. Behind nginx on a VPS, set the
# header nginx writes (proxy_set_header X-Real-IP $remote_addr) and name it:
# CLIENT_IP_HEADER=x-real-ip
